#. Plugin Name of the plugin
#: regex-validation-for-gravity-forms.php
msgid "Regex Validation for Gravity Forms"
msgstr "Regex-Validierung für Gravity Forms"

#. Description of the plugin
#: regex-validation-for-gravity-forms.php
msgid "Adds custom regex validation with Unicode support and presets to Gravity Forms fields. Includes both server-side and client-side validation."
msgstr "Fügt Gravity-Forms-Feldern benutzerdefinierte Regex-Validierung mit Unicode-Unterstützung und Voreinstellungen hinzu. Beinhaltet server- und clientseitige Validierung."

#: regex-validation-for-gravity-forms.php:58
msgid "Regex Validation for Gravity Forms requires Gravity Forms to be installed and activated."
msgstr "Für die Regex-Validierung für Gravity Forms muss Gravity Forms installiert und aktiviert sein."

#: src/RegexFieldValidator.php:34
msgid "Name (Unicode letters, spaces, hyphens, apostrophes)"
msgstr "Name (Unicode-Zeichen, Leerzeichen, Bindestriche, Apostrophe)"

#: src/RegexFieldValidator.php:36
msgid "Please enter a valid name (letters, spaces, hyphens, and apostrophes only)"
msgstr "Bitte gib einen gültigen Namen ein (nur Buchstaben, Leerzeichen, Bindestriche und Apostrophe)."

#: src/RegexFieldValidator.php:39
msgid "Email Address (RFC 5322 compliant)"
msgstr "E-Mail-Adresse (RFC 5322-konform)"

#: src/RegexFieldValidator.php:41
msgid "Please enter a valid email address"
msgstr "Bitte gib eine gültige E-Mail-Adresse ein."

#: src/RegexFieldValidator.php:44
msgid "US Phone Number"
msgstr "US-Telefonnummer"

#: src/RegexFieldValidator.php:46
msgid "Please enter a valid US phone number"
msgstr "Bitte gib eine gültige US-Telefonnummer ein."

#: src/RegexFieldValidator.php:49
msgid "International Phone Number"
msgstr "Internationale Telefonnummer"

#: src/RegexFieldValidator.php:51
msgid "Please enter a valid international phone number (E.164 format)"
msgstr "Bitte gib eine gültige internationale Telefonnummer ein (E.164-Format)."

#: src/RegexFieldValidator.php:54
msgid "Alphanumeric (Unicode)"
msgstr "Alphanumerisch (Unicode)"

#: src/RegexFieldValidator.php:56
msgid "Please enter only letters and numbers"
msgstr "Bitte gib nur Buchstaben und Zahlen ein."

#: src/RegexFieldValidator.php:59
msgid "No Special Characters (Unicode)"
msgstr "Keine Sonderzeichen (Unicode)"

#: src/RegexFieldValidator.php:61
msgid "Please enter only letters, numbers, and spaces"
msgstr "Bitte gib nur Buchstaben, Zahlen und Leerzeichen ein."

#: src/RegexFieldValidator.php:106
#: src/RegexFieldValidator.php:212
msgid "Regex Validation"
msgstr "Regex-Validierung"

#: src/RegexFieldValidator.php:111
msgid "Custom Regex"
msgstr "Benutzerdefinierter regulärer Ausdruck"

#: src/RegexFieldValidator.php:120
msgid "Regex Pattern"
msgstr "Regex-Muster"

#: src/RegexFieldValidator.php:130
msgid "Use Unicode flag (/u) for international character support"
msgstr "Nutze das Unicode-Flag (/u) für die Unterstützung internationaler Zeichen."

#: src/RegexFieldValidator.php:134
msgid "Validation Message"
msgstr "Validierungsmeldung"

#: src/RegexFieldValidator.php:140
#: src/RegexFieldValidator.php:257
#: src/RegexFieldValidator.php:299
msgid "Please enter a valid value"
msgstr "Bitte gib einen gültigen Wert ein."

#: src/RegexFieldValidator.php:213
msgid "Add custom regular expression validation to this field. Select a preset or enter your own regex pattern with Unicode support."
msgstr "Füge diesem Feld eine benutzerdefinierte Validierung mit regulären Ausdrücken hinzu. Wähle eine Voreinstellung aus oder gib dein eigenes Regex-Muster mit Unicode-Unterstützung ein."
